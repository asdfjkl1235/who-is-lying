# Port the Socket.IO/Express server listens on
PORT=4000

# Comma-free single origin (or "*" for dev) allowed to connect via CORS/sockets
CLIENT_ORIGIN=http://localhost:3000

# Optional. If set, room/session state is write-through persisted to Redis
# (Redis Cloud / Upstash both work). Omit for local dev — an in-memory
# store is used automatically.
# REDIS_URL=rediss://default:password@your-redis-host:6379
